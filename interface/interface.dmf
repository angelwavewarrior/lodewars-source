macro "macro"
	elem 
		name = "Center+REP"
	elem 
		name = "Northeast+REP"
	elem 
		name = "Southeast+REP"
	elem 
		name = "Southwest+REP"
	elem 
		name = "Northwest+REP"
	elem 
		name = "West+REP"
	elem 
		name = "North+REP"
	elem 
		name = "East+REP"
	elem 
		name = "South+REP"
	elem 
		name = "Any"
		command = "KeyDown [[*]]"
	elem 
		name = "Any+UP"
		command = "KeyUp [[*]]"


menu "menu"
	elem 
		name = "&Quit"
		command = ".quit"
		category = "&File"
		saved-params = "is-checked"


window "chat"
	elem "chat"
		type = MAIN
		pos = 291,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		background-color = none
		saved-params = "pos;size;is-minimized;is-maximized"
		titlebar = false
		statusbar = false
		can-close = false
		can-minimize = false
		can-resize = false
		is-pane = true
		outer-size = 654x494
		outer-pos = 291,0
		inner-pos = 7,7
		screen-size = 1920x1040
	elem "output"
		type = OUTPUT
		pos = 0,0
		size = 640x480
		anchor1 = 0,0
		anchor2 = 100,100
		is-default = true
		saved-params = "max-lines"

window "default"
	elem "default"
		type = MAIN
		pos = 291,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		background-color = none
		is-default = true
		saved-params = "pos;size;is-minimized;is-maximized"
		title = "Lode Wars"
		macro = "macro"
		outer-size = 656x538
		outer-pos = 291,0
		inner-pos = 8,31
		screen-size = 1920x1040
	elem "main_child"
		type = CHILD
		pos = 0,0
		size = 640x460
		anchor1 = 0,0
		anchor2 = 100,100
		background-color = none
		saved-params = "splitter"
		left = "map"
		right = "right_pane"
		is-vert = true
		splitter = 80

