/mob/verb/instructions()
	set desc = "Displays instructions for the game in the browser tab."
	ShowHelpDoc()

/mob/verb/item_guide()
	set desc = "Displays complete information on item effects and usage in the browser tab."
	ItemGuidePics(src)
	src << browse('lodeitem.html')

/mob/proc/ShowHelpDoc()
	InitHelpPics(src)
	src << browse('lodehelp.html')
